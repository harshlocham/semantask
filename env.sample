# Semantask environment configuration
#
# Layers (do not put product policy in env when it belongs on OrganizationPolicy):
#   1. Secrets + infrastructure + deployment identity — this file
#   2. Typed parsers — packages/services/config (product flags) and per-app env
#   3. Application defaults — code constants / parser fallbacks below
#   4. OrganizationPolicy — per-org overlays (executionMode, promptGuard, …)
#
# OAuth uses Host headers then APP_URL.
#
# Dual-read still accepted (boot warns when only the alias is set):
#   INTERNAL_SECRET → INTERNAL_SECRET_SOCKET / INTERNAL_SECRET_WORKER
# NEXT_PUBLIC_PUBLIC_KEY remains for the client ImageKit helper.

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/semantask

# Redis Configuration
# REDIS_URL — TCP/ioredis for socket, task-worker, and web.
# UPSTASH_REDIS_REST_URL / TOKEN — web REST client only (not an ioredis URL).
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Authentication Secrets
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
# Legacy shared secret (still accepted during deprecation window)
INTERNAL_SECRET=your_internal_secret_for_service_communication
# Per-service secrets (Phase 3.4) — prefer these in new deploys
# INTERNAL_SECRET_SOCKET=secret_held_by_web_and_worker__accepted_by_socket
# INTERNAL_SECRET_WORKER=secret_held_by_socket_and_web_middleware__accepted_by_web_internal
# Optional previous values for zero-downtime rotation:
# INTERNAL_SECRET_SOCKET_PREVIOUS=
# INTERNAL_SECRET_WORKER_PREVIOUS=
COOKIE_DOMAIN=

# OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ImageKit Configuration (Media Upload)
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
NEXT_PUBLIC_PUBLIC_KEY=your_imagekit_public_key
NEXT_PUBLIC_URI_ENDPOINT=https://ik.imagekit.io/your_account_id

# SMTP Configuration (Email Service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_password
# EMAIL_FROM=  # optional From; falls back to SMTP_USER

# Server Configuration
NODE_ENV=development
ORIGIN=http://localhost:3000,http://localhost:3001
WEB_SERVER_URL=http://localhost:3000
SOCKET_SERVER_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# VPS / Docker Compose production example (semantask.com):
# NODE_ENV=production
# ORIGIN=https://semantask.com
# APP_URL=https://semantask.com
# COOKIE_DOMAIN=.semantask.com
# Do NOT set NEXT_PUBLIC_SOCKET_URL — nginx proxies /api/socket on the same host.
# REDIS_URL / SOCKET_SERVER_URL are overridden by docker-compose.yml for in-stack Redis/socket.
# Google OAuth redirect URIs are derived from request Host + X-Forwarded-Proto on the server.

# Task Worker / LLM Configuration
LLM_PROVIDER=openai-compatible

LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=your_api_key_here

TASK_AGENT_MODEL=qwen3.5-coder-32b

TASK_AGENT_LLM_TIMEOUT_MS=45000

LLM_SUPPORTS_RESPONSES_API=false
LLM_SUPPORTS_JSON_MODE=false
LLM_SUPPORTS_STRUCTURED_OUTPUTS=true
LLM_SUPPORTS_TOOL_CALLING=true
LLM_SUPPORTS_STREAMING=true

# Tool-specific API keys
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Chat App <noreply@example.com>

# Task worker policy (production: set explicit domains before enabling send_email)
# TASK_WORKER_ALLOWED_EMAIL_DOMAINS=example.com,mail.example.com

# Execution FSM is baked authoritative: dual-write executionState, project legacy
# lifecycle/status, emit policy/retry shadow events, and log state divergence.

# Retry scanner batch size per tick (Phase 6.2; default 10)
# TASK_RETRY_BATCH_SIZE=10

# Outbox horizontal partitions — one worker replica per OUTBOX_PARTITION_ID (Phase 6.3)
# OUTBOX_PARTITION_COUNT=1
# OUTBOX_PARTITION_ID=0
# Production refuses to start without Redis unless override is set
# TASK_WORKER_ALLOW_NO_REDIS=1

# Outbox archival of completed/dead_letter rows (Phase 6.4)
# OUTBOX_RETENTION_DAYS=14
# OUTBOX_ARCHIVE_INTERVAL_MS=3600000

# Message ingress classifier: regex (default) | shadow | llm
# Progression: regex → shadow (staging bake-in) → llm. Production default stays regex.
# In shadow, regex remains authoritative; LLM disagreements increment classifier_disagreement_total.
# Disagreement rate (aggregate label dimensions before dividing):
#   sum(classifier_disagreement_total)
#     / sum(classifier_classifications_total{mode="shadow"})
# TASK_CLASSIFIER_MODE=regex
# TASK_CLASSIFIER_THRESHOLD=0.7
# TASK_CLASSIFIER_MODEL=gpt-4o-mini
# TASK_CLASSIFIER_LLM_TIMEOUT_MS=3000

# Per-intent execution confidence thresholds (JSON overlay; defaults: task/scheduling 0.7, incident/automation 0.75)
# TASK_EXECUTION_CONFIDENCE_THRESHOLDS={"task":0.7,"incident":0.75,"automation":0.75}

# Prompt injection guard: off | monitor (default, log denies) | enforce (block)
# TASK_PROMPT_GUARD=monitor

# Tool RBAC: off | enforce (default — deny high-risk tools without ToolGrant)
# Production without seeded grants must set TASK_TOOL_RBAC=off or seed grants first.
# TASK_TOOL_RBAC=enforce

# Workspace execution mode (ADR-005): suggest_only | require_approval | auto_execute
# DEFAULT_EXECUTION_MODE applies to personal workspaces and orgs with no executionMode field.
# Parsed in packages/services/config (not OrganizationPolicy.service).
# DEFAULT_EXECUTION_MODE=suggest_only
# GRANDFATHER_AUTO_TENANTS=  # comma-separated org IDs forced to auto_execute
# One-shot: pnpm grandfather:auto-execute --dry-run  then  pnpm grandfather:auto-execute
# Clear this list in the same deploy. Keep the parser until the list is empty.

# WorkSuggestion ingress is always on. Under suggest_only, classify dual-writes
# WorkSuggestion and does not enqueue execution (except explicit manager request).
# Suggestion accept never enqueues execution. Work Inbox (/inbox) is always on.

# Phase 3 coordination board (todo | doing | done). Default off.
# COORDINATION_BOARD=0

# Phase 3 org coordination dashboard. Default off.
# ORG_DASHBOARD=0

# Product notifications (assign / approval / mention / blocked / overdue):
# email via RESEND_API_KEY + RESEND_FROM_EMAIL (preferred), else SMTP_HOST/USER/PASS;
# optional live push via socket. Absolute CTAs use APP_URL (or PUBLIC_APP_URL).
# PUBLIC_APP_URL=https://app.example.com
# SOCKET_INTERNAL_URL=http://localhost:4001
# INTERNAL_SOCKET_URL=  # alias for SOCKET_INTERNAL_URL
# Required for overdue scan. POST /api/internal/cron/overdue-notify fails closed
# (401) when this is missing or blank. Send the same value as x-internal-cron-token.
# INTERNAL_CRON_TOKEN=replace_with_a_long_random_token

# Stuck task detector: log (default) | fail | retry
# TASK_STUCK_REMEDIATION=log
# TASK_STUCK_HEARTBEAT_MS=20000
# TASK_STUCK_DETECTION_INTERVAL_MS=60000

# Task cancellation is always available via POST /api/tasks/:id/cancel when not terminal.
