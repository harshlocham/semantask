# Semantask environment configuration
# Copy to `.env` at the repository root.
#
# Layers:
#   1. Secrets + infrastructure + deployment identity — this file
#   2. Typed parsers — packages/services/config, apps/*/config
#   3. Application defaults — code constants (not listed here)
#   4. OrganizationPolicy — per-org executionMode, promptGuard, thresholds, tool policy
#
# Per-org product policy belongs on OrganizationPolicy, not env.
# See docs/operations/PRODUCTION_REQUIREMENTS.md for production setup.

# Infrastructure
MONGODB_URI=mongodb://localhost:27017/semantask
REDIS_URL=redis://localhost:6379
# Web REST rate-limit cache only (not ioredis — task-worker/socket use REDIS_URL)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Authentication
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
COOKIE_DOMAIN=

# Service Authentication
# Prefer distinct secrets in new deploys; INTERNAL_SECRET is legacy fallback only.
INTERNAL_SECRET=your_internal_secret_for_service_communication
# INTERNAL_SECRET_SOCKET=secret_for_web_and_worker_calling_socket
# INTERNAL_SECRET_WORKER=secret_for_socket_calling_web_internal_routes
# INTERNAL_SECRET_SOCKET_PREVIOUS=
# INTERNAL_SECRET_WORKER_PREVIOUS=
INTERNAL_CRON_TOKEN=

# OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Media
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
NEXT_PUBLIC_PUBLIC_KEY=your_imagekit_public_key
NEXT_PUBLIC_URI_ENDPOINT=https://ik.imagekit.io/your_account_id

# Email (Resend — OTP, invites, and notifications)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Chat App <noreply@example.com>
# EMAIL_FROM=  # optional From fallback when RESEND_FROM_EMAIL is unset

# Application
NODE_ENV=development
ORIGIN=http://localhost:3000,http://localhost:3001
APP_URL=http://localhost:3000
# PUBLIC_APP_URL=  # optional override for notification email CTAs
WEB_SERVER_URL=http://localhost:3000

# Socket
SOCKET_SERVER_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
# SOCKET_INTERNAL_URL=http://localhost:3001  # notify.service live push target
# Production behind nginx on one host: omit NEXT_PUBLIC_SOCKET_URL (same-origin proxy).

# LLM / Task Worker
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=your_api_key_here
TASK_AGENT_MODEL=qwen3.5-coder-32b
TASK_AGENT_LLM_TIMEOUT_MS=45000
LLM_SUPPORTS_RESPONSES_API=false
LLM_SUPPORTS_JSON_MODE=false
LLM_SUPPORTS_STRUCTURED_OUTPUTS=true
LLM_SUPPORTS_TOOL_CALLING=true
LLM_SUPPORTS_STREAMING=true
# TASK_WORKER_ALLOWED_EMAIL_DOMAINS=example.com,mail.example.com
# GITHUB_TOKEN=
# GITHUB_REPO=
# SCHEDULE_MEETING_WEBHOOK_URL=

# Internal Security / runtime tuning (optional — code defaults apply)
# DEFAULT_EXECUTION_MODE=suggest_only  # bootstrap for personal workspaces / orgs without policy
# GRANDFATHER_AUTO_TENANTS=  # deprecated; only when org executionMode is unset
# TASK_TOOL_RBAC=enforce  # bootstrap grant gate; org deny list still applies when off
# TASK_CLASSIFIER_MODE=regex  # regex | shadow | llm
# COORDINATION_BOARD=0
# ORG_DASHBOARD=0
# TASK_WORKER_ALLOW_NO_REDIS=1  # dev only; production requires REDIS_URL
