{
    "name": "@semantask/db",
    "version": "3.3.0",
    "type": "module",
    "main": "./dist/db.js",
    "types": "./dist/db.d.ts",
    "exports": {
        ".": {
            "import": "./dist/db.js",
            "types": "./dist/db.d.ts",
            "default": "./dist/db.js"
        },
        "./db": {
            "import": "./dist/db.js",
            "types": "./dist/db.d.ts",
            "default": "./dist/db.js"
        },
        "./mongo": {
            "import": "./dist/mongo.js",
            "types": "./dist/mongo.d.ts",
            "default": "./dist/mongo.js"
        },
        "./offlineMessages": {
            "import": "./dist/offlineMessages.js",
            "types": "./dist/offlineMessages.d.ts",
            "default": "./dist/offlineMessages.js"
        },
        "./models/*": {
            "import": "./dist/models/*.js",
            "types": "./dist/models/*.d.ts",
            "default": "./dist/models/*.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "NODE_OPTIONS='--experimental-vm-modules' jest --config ./jest.config.cjs"
    },
    "dependencies": {
        "dexie": "^4.2.1",
        "mongoose": "^8.16.2",
        "mongodb": "^4.17.2"
    },
    "devDependencies": {
        "@jest/globals": "30.4.1",
        "@types/jest": "^30.0.0",
        "jest": "^30.4.1",
        "ts-jest": "^29.4.4"
    }
}